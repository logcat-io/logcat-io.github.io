---
// 방문자 카운터 — GoatCounter 공개 카운터(/counter/TOTAL.json)를 클라이언트에서 직접 읽음.
// 내 DB·서버·API 토큰 0. 카운터가 꺼져 있거나(403) fetch 실패하면 placeholder 는 숨김 유지 → 레이아웃 안 깨짐.
// ⚠️ 동작하려면 GoatCounter 설정에서 "Allow adding visitor counts on your website" 를 켜야 함.
interface Props {
  variant: 'nav' | 'footer';
}
const { variant } = Astro.props;
---

{
  variant === 'nav' && (
    <span
      class="visit visit--nav"
      data-visit
      hidden
      aria-label="방문자 — 최근 7일 / 누적"
      title="최근 7일 / 누적 방문자 · 최대 4시간 지연"
    >
      <span class="visit-dot" aria-hidden="true" />
      <b data-gc-week>–</b>
      <span class="visit-sep" aria-hidden="true">/</span>
      <b data-gc-total>–</b>
    </span>
  )
}
{
  variant === 'footer' && (
    <span class="visit visit--footer" data-visit hidden>
      {' · 7D '}
      <b data-gc-week>–</b>
      {' · TOTAL '}
      <b data-gc-total>–</b>
    </span>
  )
}

<script>
  const ENDPOINT = 'https://logcat.goatcounter.com/counter/TOTAL.json';
  // 수집 시작일. start 를 안 주면 전체 기간이 아니라 더 좁은 창이 잡혀 누적이 실제보다 적게 나온다.
  const SITE_START = '2026-06-21';

  // 공개 카운터 응답은 4시간 캐시되고, 모르는 쿼리 파라미터는 캐시 키에서 빠져 무력화가 안 된다.
  // "오늘" 을 쓰면 자정부터 몇 시간 동안 0 에 굳는다. 7일 창이면 같은 지연이 오차로 묻힌다.
  const kstDate = (d: Date) =>
    new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(d);
  const weekStart = kstDate(new Date(Date.now() - 6 * 86400000));

  const fetchCount = async (start: string): Promise<number | null> => {
    try {
      const res = await fetch(`${ENDPOINT}?start=${start}`);
      if (!res.ok) return null;
      const body = await res.json();
      // count_unique = 방문자, count = 페이지뷰. 라벨이 방문자이므로 전자를 쓴다.
      const n = Number(body.count_unique ?? body.count);
      return Number.isFinite(n) ? n : null;
    } catch {
      return null;
    }
  };

  (async () => {
    const [total, week] = await Promise.all([fetchCount(SITE_START), fetchCount(weekStart)]);
    if (total === null) return; // 카운터 비활성/오류 → 숨김 유지

    const put = (sel: string, v: number) =>
      document
        .querySelectorAll<HTMLElement>(sel)
        .forEach((el) => { el.textContent = v.toLocaleString('ko-KR'); });

    put('[data-gc-total]', total);
    put('[data-gc-week]', week ?? 0);
    document
      .querySelectorAll<HTMLElement>('[data-visit]')
      .forEach((el) => { el.hidden = false; });
  })();
</script>

<style>
  .visit[hidden] {
    display: none;
  }

  /* 네브바 우측: ⊙ 12 / 3,456 */
  .visit--nav {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--g-45);
  }
  .visit--nav .visit-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: var(--ink);
  }
  .visit--nav b {
    color: var(--ink);
    font-weight: 700;
  }
  .visit--nav .visit-sep {
    opacity: 0.45;
  }

  /* 푸터 상태 줄: ... · TODAY 12 · TOTAL 3,456 · ... (모노/대문자/자간은 .status 에서 상속) */
  .visit--footer b {
    color: var(--g-60);
    font-weight: 600;
  }
</style>
